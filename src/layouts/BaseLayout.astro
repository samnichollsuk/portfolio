---
import { profile } from "../data/profile";
import "../styles/global.css";

interface Props {
	title: string;
	description: string;
	/** Keep the page out of search results (e.g. the 404 page). */
	noindex?: boolean;
}

const { title, description, noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL("/og-image.png", Astro.site);

// Tells search engines who the site is about. https://schema.org/Person
const person = {
	"@context": "https://schema.org",
	"@type": "Person",
	name: profile.name,
	jobTitle: profile.title,
	url: Astro.site?.href,
	email: `mailto:${profile.email}`,
	sameAs: profile.socials.map((social) => social.href),
};
---

<!doctype html>
<html lang="en-GB" class="scroll-pt-20 scroll-smooth scheme-light-dark motion-reduce:scroll-auto">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{title}</title>
		<meta name="description" content={description} />
		{noindex && <meta name="robots" content="noindex" />}
		<link rel="canonical" href={canonical} />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<link rel="sitemap" href="/sitemap-index.xml" />
		{/* Keep in sync with --color-bg (light and dark) in src/styles/global.css. */}
		<meta name="theme-color" content="#fbfaf7" media="(prefers-color-scheme: light)" />
		<meta name="theme-color" content="#111317" media="(prefers-color-scheme: dark)" />

		<meta property="og:type" content="website" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonical} />
		<meta property="og:site_name" content={profile.name} />
		<meta property="og:locale" content="en_GB" />
		<meta property="og:image" content={ogImage} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content={`${profile.name}, ${profile.title}`} />
		<meta name="twitter:card" content="summary_large_image" />

		<script type="application/ld+json" set:html={JSON.stringify(person)} />

		<meta name="generator" content={Astro.generator} />
	</head>
	<body class="bg-bg text-fg font-sans text-[1.0625rem] leading-[1.6] antialiased [text-rendering:optimizeLegibility]">
		<a
			class="bg-fg text-bg absolute top-3 left-3 z-100 -translate-y-[200%] rounded-lg px-4 py-2 focus:translate-none"
			href="#main">Skip to content</a
		>
		<slot />
	</body>
</html>
