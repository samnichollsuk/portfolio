---
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import { profile } from "../data/profile";
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title={`Page not found · ${profile.name}`} description="This page doesn’t exist." noindex>
	<Header />
	<main id="main" class="wrapper grid gap-4 py-[clamp(5rem,15vw,10rem)]">
		<p class="eyebrow">404</p>
		<h1 class="text-[clamp(2rem,5vw,3rem)] font-bold">This page doesn’t exist.</h1>
		<p><a href="/">Back to the home page</a></p>
	</main>
	<Footer />
</BaseLayout>
