---
interface Props {
	id: string;
	title: string;
	eyebrow?: string;
}

const { id, title, eyebrow } = Astro.props;
const headingId = `${id}-heading`;
---

<section id={id} aria-labelledby={headingId} class="border-border border-t py-[clamp(3.5rem,8vw,6rem)]">
	<div class="wrapper">
		<header class="mb-[clamp(2rem,4vw,3rem)] grid gap-2">
			{eyebrow && <p class="eyebrow">{eyebrow}</p>}
			<h2 id={headingId} class="text-[clamp(1.75rem,3.5vw,2.25rem)] font-bold">{title}</h2>
		</header>
		<slot />
	</div>
</section>
