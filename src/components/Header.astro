---
import { profile } from "../data/profile";

const links = [
	{ href: "#projects", label: "Projects" },
	{ href: "#contact", label: "Contact" },
];
---

<header class="border-border bg-bg/92 sticky top-0 z-10 border-b backdrop-blur-[10px]">
	<div class="wrapper flex min-h-16 items-center justify-between gap-4">
		<a
			class="text-fg inline-flex items-center gap-2.5 font-semibold no-underline"
			href="/"
			aria-label={`${profile.name}, home`}
		>
			<span
				class="bg-brand-gradient text-on-accent grid size-8 place-items-center rounded-lg text-xs tracking-[0.02em]"
				aria-hidden="true">SN</span
			>
			<span class="max-sm:hidden">{profile.name}</span>
		</a>
		<nav aria-label="Main">
			<ul class="flex gap-[clamp(0.75rem,2.5vw,1.75rem)]">
				{/* Vertical padding keeps each link at least 24px tall (WCAG 2.5.8 target size). */}
				{links.map((link) => (
					<li>
						<a class="text-muted hover:text-fg inline-block py-2 text-[0.9375rem] no-underline" href={link.href}>
							{link.label}
						</a>
					</li>
				))}
			</ul>
		</nav>
	</div>
</header>
