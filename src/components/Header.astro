---
import { profile } from "../data/profile";

const links = [
	{ href: "#projects", label: "Projects" },
	{ href: "#contact", label: "Contact" },
];
---

<header class="sticky top-0 z-10 border-b border-border bg-bg/92 backdrop-blur-[10px]">
	<div class="wrapper flex min-h-16 items-center justify-between gap-4">
		<a
			class="inline-flex items-center gap-2.5 font-semibold text-fg no-underline"
			href="/"
			aria-label={`${profile.name}, home`}
		>
			<span
				class="grid size-8 place-items-center rounded-lg bg-brand-gradient text-xs tracking-[0.02em] text-on-accent"
				aria-hidden="true">SN</span
			>
			<span class="max-sm:hidden">{profile.name}</span>
		</a>
		<nav aria-label="Main">
			<ul class="flex gap-[clamp(0.75rem,2.5vw,1.75rem)]">
				{/* Vertical padding keeps each link at least 24px tall (WCAG 2.5.8 target size). */}
				{links.map((link) => (
					<li>
						<a class="inline-block py-2 text-[0.9375rem] text-muted no-underline hover:text-fg" href={link.href}>
							{link.label}
						</a>
					</li>
				))}
			</ul>
		</nav>
	</div>
</header>
