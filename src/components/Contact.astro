---
import Section from "./Section.astro";
import { profile } from "../data/profile";
---

<Section id="contact" title="Let’s talk" eyebrow="Contact">
	<p class="mb-6 max-w-[50ch] text-lg text-muted">
		Whether you have a role, a project or just want to say hello, my inbox is open.
	</p>
	<a
		class="text-[clamp(1.375rem,4.5vw,2.5rem)] font-bold tracking-[-0.02em] wrap-anywhere decoration-accent-2"
		href={`mailto:${profile.email}`}><span class="gradient-text">{profile.email}</span></a
	>
</Section>
