---
import Section from "./Section.astro";
import { profile } from "../data/profile";
---

<Section id="contact" title="Let’s talk" eyebrow="Contact">
	<p class="intro">
		Whether you have a role, a project or just want to say hello, my inbox is open.
	</p>
	<a class="email" href={`mailto:${profile.email}`}><span class="gradient-text">{profile.email}</span></a>
</Section>

<style>
	.intro {
		max-width: 50ch;
		margin-bottom: 1.5rem;
		color: var(--muted);
		font-size: 1.125rem;
	}

	.email {
		font-size: clamp(1.375rem, 4.5vw, 2.5rem);
		font-weight: 700;
		letter-spacing: -0.02em;
		overflow-wrap: anywhere;
		text-decoration-color: var(--accent-2);
	}
</style>
