---
import { profile } from "../data/profile";
---

<section class="hero" aria-labelledby="hero-heading">
	<div class="container">
		<p class="eyebrow">{profile.title}</p>
		<h1 id="hero-heading">
			Hi, I’m {profile.name.split(" ")[0]}. I build for the web: <span class="gradient-text">fast for everyone, usable by everyone.</span>
		</h1>
		<p class="summary">{profile.summary}</p>
		<div class="actions">
			<a class="button primary" href={`mailto:${profile.email}`}>Get in touch</a>
			<a class="button" href="#projects">See my projects</a>
		</div>
	</div>
</section>

<style>
	.hero {
		position: relative;
		isolation: isolate;
		overflow: hidden;
		padding-block: clamp(4rem, 12vw, 8rem) clamp(3.5rem, 8vw, 6rem);
	}

	/* Soft colour wash behind the intro. */
	.hero::before {
		content: "";
		position: absolute;
		inset: -20% -10% auto auto;
		z-index: -1;
		width: min(48rem, 90vw);
		aspect-ratio: 1;
		background:
			radial-gradient(closest-side at 35% 45%, var(--glow-1), transparent),
			radial-gradient(closest-side at 65% 60%, var(--glow-2), transparent);
		pointer-events: none;
	}

	.container {
		display: grid;
		gap: 1.5rem;
	}

	h1 {
		max-width: 22ch;
		font-size: clamp(2.25rem, 6vw, 4rem);
		font-weight: 700;
	}

	.summary {
		max-width: 60ch;
		color: var(--muted);
		font-size: clamp(1.0625rem, 1.6vw, 1.1875rem);
	}

	.actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
		margin-top: 0.5rem;
	}

	.button {
		display: inline-flex;
		align-items: center;
		min-height: 2.75rem;
		padding-inline: 1.25rem;
		border: 1px solid var(--border-strong);
		border-radius: 999px;
		color: var(--text);
		font-weight: 500;
		text-decoration: none;
		transition: border-color 150ms ease, background-color 150ms ease;
	}

	.button:hover {
		border-color: var(--text);
	}

	.button.primary {
		background: var(--text);
		border-color: var(--text);
		color: var(--bg);
	}

	.button.primary:hover {
		background: var(--gradient);
		border-color: transparent;
		color: var(--on-accent);
	}
</style>
