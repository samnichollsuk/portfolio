---
import { profile } from "../data/profile";

const button =
	"inline-flex min-h-11 items-center rounded-full border px-5 font-medium no-underline transition-[border-color,background-color] duration-150";
---

<section
	class="relative isolate overflow-hidden pt-[clamp(4rem,12vw,8rem)] pb-[clamp(3.5rem,8vw,6rem)]"
	aria-labelledby="hero-heading"
>
	{/* Soft colour wash behind the intro. */}
	<div
		class="pointer-events-none absolute -top-[20%] -right-[10%] -z-10 aspect-square w-[min(48rem,90vw)] bg-[radial-gradient(closest-side_at_35%_45%,var(--color-glow-1),transparent),radial-gradient(closest-side_at_65%_60%,var(--color-glow-2),transparent)]"
		aria-hidden="true"
	>
	</div>
	<div class="wrapper grid gap-6">
		<p class="eyebrow">{profile.title}</p>
		<h1 id="hero-heading" class="max-w-[22ch] text-[clamp(2.25rem,6vw,4rem)] font-bold">
			Hi, I’m {profile.name.split(" ")[0]}. I build for the web: <span class="gradient-text"
				>fast for everyone, usable by everyone.</span
			>
		</h1>
		<p class="text-muted max-w-[60ch] text-[clamp(1.0625rem,1.6vw,1.1875rem)]">{profile.summary}</p>
		<div class="mt-2 flex flex-wrap gap-3">
			<a
				class:list={[
					button,
					"border-fg bg-fg text-bg hover:bg-brand-gradient hover:text-on-accent hover:border-transparent",
				]}
				href={`mailto:${profile.email}`}>Get in touch</a
			>
			<a class:list={[button, "border-border-strong text-fg hover:border-fg"]} href="#projects">See my projects</a>
		</div>
	</div>
</section>
