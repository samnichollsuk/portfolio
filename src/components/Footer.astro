---
import { profile } from "../data/profile";

const year = new Date().getFullYear();
---

<footer class="border-border text-muted border-t py-8 text-sm">
	<div class="wrapper flex flex-wrap items-center justify-between gap-x-6 gap-y-2">
		<p>© {year} {profile.name}</p>
		<ul class="flex gap-x-5" aria-label="Social profiles">
			{
				profile.socials.map((social) => (
					<li>
						<a class="text-muted hover:text-fg inline-block py-1 no-underline" href={social.href}>
							{social.label}
						</a>
					</li>
				))
			}
		</ul>
	</div>
</footer>
