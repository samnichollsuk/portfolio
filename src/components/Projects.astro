---
import Section from "./Section.astro";
---

<Section id="projects" title="Projects" eyebrow="Selected work">
	<div
		class="border-border bg-surface grid justify-items-start gap-3 rounded-xl border border-dashed bg-[radial-gradient(40rem_16rem_at_100%_0%,var(--color-glow-2),transparent)] p-[clamp(2rem,5vw,3.5rem)]"
	>
		<span
			class="bg-accent-soft text-accent rounded-full px-3 py-1 font-mono text-[0.8125rem] tracking-[0.04em] uppercase"
			>Coming soon</span
		>
		<p class="text-[clamp(1.25rem,2.5vw,1.5rem)] font-semibold tracking-[-0.01em]">
			I’m putting together write-ups of things I’ve built.
		</p>
		<p class="text-muted">Check back soon for case studies and side projects.</p>
	</div>
</Section>
