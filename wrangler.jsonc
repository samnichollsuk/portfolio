{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "portfolio",
	"compatibility_date": "2026-11-25",
	// Static site: Astro builds to ./dist and Cloudflare serves it directly.
	"assets": {
		"directory": "./dist",
		"not_found_handling": "404-page"
	},
	// Serve on the custom domain only, not on a *.workers.dev URL.
	"workers_dev": false,
	"routes": [{ "pattern": "samnicholls.co.uk", "custom_domain": true }]
}
